{% comment %}
----------------------------------------------------------------------------------------------------------------------
RS BUY MORE & SAVE MORE
----------------------------------------------------------------------------------------------------------------------
Automatically displays multi-buy savings based on compare_at_price.
Uses dynamic store currency (supports currency_code_enabled).

Discount tiers:
1 item → 16% OFF (Calculated from compare_at_price)
2 items → 26% OFF (Calculated from base price)
3 items → 36% OFF (Calculated from base price)
----------------------------------------------------------------------------------------------------------------------
{% endcomment %}

{% assign base_variant = product.selected_or_first_available_variant %}
{% assign base_price = base_variant.price %}
{% assign compare_price = base_variant.compare_at_price | default: base_price %}

{% if base_price > 0 %}
  {% assign discount_16 = compare_price | times: 0.84 %}
  {% assign discount_26 = base_price | times: 0.74 %}
  {% assign discount_36 = base_price | times: 0.64 %}

  <div class="rs-buy-more">
    <h3 class="rs-buy-more__title">
      <strong>{{ title }}</strong>. {{ description }}
    </h3>

    <div class="rs-buy-more__grid">
      {% assign tiers = "1,2,3" | split: "," %}
      {% for tier in tiers %}
        {% case tier %}
          {% when "1" %}
            {% assign discount = 16 %}
            {% assign new_price = discount_16 %}
            {% assign reference_price = compare_price %}
          {% when "2" %}
            {% assign discount = 26 %}
            {% assign new_price = discount_26 %}
            {% assign reference_price = base_price %}
          {% when "3" %}
            {% assign discount = 36 %}
            {% assign new_price = discount_36 %}
            {% assign reference_price = base_price %}
        {% endcase %}

        {% assign saved = reference_price | minus: new_price %}

        <div class="rs-buy-more__item">
          <div class="rs-buy-more__header">
            <strong>{{ tier }} {{ discount_on_item }}{% if tier != "1" %}S{% endif %}</strong>
          </div>
          <div class="rs-buy-more__discount">{{ discount }}% OFF</div>
          <div class="rs-buy-more__price">
            {% if settings.currency_code_enabled %}
              {{ new_price | money_with_currency }}
            {% else %}
              {{ new_price | money }}
            {% endif %}
            {% if tier != "1" %}<span>each</span>{% endif %}
          </div>
          <div class="rs-buy-more__saved">
            <span class="text-green">
              {% if settings.currency_code_enabled %}
                {{ saved | money_with_currency }}
              {% else %}
                {{ saved | money }}
              {% endif %}
              saved
            </span>
          </div>
        </div>
      {% endfor %}
    </div>

    <p class="rs-buy-more__note">{{ bottom_content }}<strong id="learnMoreBtn">learn more</strong></p>
  </div>
{% endif %}

<div id="infoModal" class="modal-overlay">
    <div class="modal-content">
        <span class="modal-close" id="closeBtn">&times;</span>
        {{ learn_more_text }}
    </div>
</div>

<script>
    // Get the elements
    const modal = document.getElementById("infoModal");
    const learnMoreBtn = document.getElementById("learnMoreBtn");
    const closeBtn = document.getElementById("closeBtn");

    // Function to open the modal
    learnMoreBtn.onclick = function() {
        modal.style.display = "flex";
    }

    // Function to close the modal
    closeBtn.onclick = function() {
        modal.style.display = "none";
    }

    // Close the modal if the user clicks anywhere on the overlay outside of the content
    window.onclick = function(event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }
</script>
<style>
/* Style for the 'learn more' text to make it look clickable */
    .rs-buy-more__note strong {
        cursor: pointer;
        margin-left: 8px;
    }

    /* Modal Overlay */
    .modal-overlay {
        display: none; /* Hidden by default */
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.5); /* Dim background */
        justify-content: center;
        align-items: center;
    }

    /* Modal Content Box */
  #infoModal  .modal-content {
        background-color: #ffffff;
        margin: auto;
        padding: 30px;
        border: 1px solid #ccc;
        border-radius: 10px;
        width: 80%;
        max-width: 500px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        position: relative;
        animation: fadeIn 0.3s;
    }

    /* Modal Close Button */
  #infoModal  .modal-close {
        color: #aaa;
        position: absolute;
        top: 10px;
        right: 20px;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

  #infoModal  .modal-close:hover,
  #infoModal  .modal-close:focus {
      color: #333;
  }


    /* Simple fade-in animation */
    @keyframes fadeIn {
        from {opacity: 0; transform: scale(0.95);}
        to {opacity: 1; transform: scale(1);}
    }
    
  .rs-buy-more {
    text-align: center;
    margin-top: 2em;
  }

  .rs-buy-more__title {
    margin-bottom: 1em;
  }

  .rs-buy-more__grid {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: nowrap;
  }

  .rs-buy-more__item {
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 8px;
    padding: 12px 16px;
    min-width: calc(33% - 20px);
    background: #fff;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  }

  .rs-buy-more__header {
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 4px;
  }

  .rs-buy-more__discount {
    font-size: 13px;
    color: #555;
    margin-bottom: 6px;
  }

  .rs-buy-more__price {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .rs-buy-more__price span {
    font-size: 13px;
    font-weight: 400;
    color: #555;
  }

  .rs-buy-more__saved {
    font-size: 13px;
    color: #2E8B57;
  }

  .rs-buy-more__note {
    border-radius: 15px;
    background-color: #F7F7F7;
    font-size: 13px;
    color: #000;
    padding: 15px;
    margin-top: 20px;
    margin-bottom: 20px;
  }
</style>