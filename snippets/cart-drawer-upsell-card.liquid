{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
CART DRAWER UPSELL CARD
----------------------------------------------------------------------------------------------------------------------

Product card used in the cart drawer "finish bundle deal" carousel: image, title, price, size selector and an "Add"
button. The form uses the theme's product-form, so adding stays inside the drawer and the drawer refreshes itself.

********************************************
Supported variables
********************************************

* product: the product to render (required)
{%- endcomment -%}

{%- liquid
  assign form_id = 'cd-upsell-' | append: section.id | append: '-' | append: product.id
  assign select_id = form_id | append: '-variant'
  assign first_variant = product.selected_or_first_available_variant
-%}

<div class="cd-upsell__card" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="cd-upsell__media" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media != blank -%}
      {{- product.featured_media | image_url: width: product.featured_media.width | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 45vw, 210px', widths: '200,300,400,600', class: 'cd-upsell__image', alt: product.title -}}
    {%- else -%}
      {{- 'product-1' | placeholder_svg_tag: 'cd-upsell__image' -}}
    {%- endif -%}
  </a>

  <div class="cd-upsell__info">
    <a href="{{ product.url }}" class="cd-upsell__title">{{ product.title }}</a>

    <p class="cd-upsell__prices">
      <span class="sr-only">{{ 'product.price.sale_price' | t }}</span>
      <span>{{ first_variant.price | money }}</span>
      {%- if first_variant.compare_at_price > first_variant.price -%}
        <span class="sr-only">{{ 'product.price.regular_price' | t }}</span>
        <s class="cd-upsell__compare">{{ first_variant.compare_at_price | money }}</s>
      {%- endif -%}
    </p>
  </div>

  {%- form 'product', product, id: form_id, is: 'product-form', class: 'cd-upsell__form' -%}
    <input type="hidden" name="quantity" value="1">

    {%- if product.has_only_default_variant -%}
      <input type="hidden" name="id" value="{{ first_variant.id }}">
    {%- else -%}
      <div class="cd-select-wrapper cd-upsell__size">
        <label for="{{ select_id }}" class="sr-only">{{ section.settings.upsell_choose_size | escape }}: {{ product.title | escape }}</label>
        <select id="{{ select_id }}" name="id" class="cd-select" required>
          <option value="" selected disabled>{{ section.settings.upsell_choose_size | escape }}</option>
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
              {{- variant.title -}}
              {%- unless variant.available %} – {{ 'product.general.sold_out_button' | t }}{% endunless -%}
            </option>
          {%- endfor -%}
        </select>
      </div>
    {%- endif -%}

    <button type="submit" class="cd-upsell__add" aria-label="{{ section.settings.upsell_add_text | escape }}: {{ product.title | escape }}">
      {{- section.settings.upsell_add_text | escape -}}
    </button>
  {%- endform -%}

  <p class="cd-upsell__error" role="alert" hidden></p>
</div>
