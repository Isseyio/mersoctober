ype":"rich-text","blocks":{"richtext_Xyg9tz":{"type":"richtext","settings":{"content":"<p>The iconic Woolmark logo represents an unwavering commitment to quality, ensuring outstanding performance in every certified product.<\/p>"}}},"block_order":["richtext_Xyg9tz"],"disabled":true,"name":"Rich text","settings":{"full_width":true,"content_width":"small","text_position":"center","background":"","background_gradient":"","text_color":""}},"image_link_blocks_9RCHGc":{"type":"image-link-blocks","blocks":{"item_aCY7hg":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/s-blob-v1-IMAGE-z8ku2C6-jeg.png","stretch_image":true,"link_text":"GLOBALLY SOURCED","link_url":"","background":"","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}},"item_BCynqM":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/s-blob-v1-IMAGE-qG8YmWy4_-M.png","stretch_image":true,"link_text":"FINE FIBRES","link_url":"","background":"","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}},"item_aaGpbL":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/s-blob-v1-IMAGE-gaPwyuD1Dvs.png","stretch_image":true,"link_text":"PRECISION SPINNING","link_url":"","background":"","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}},"item_NzHbHc":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/s-blob-v1-IMAGE-Ke2hzyMo8Mk.png","stretch_image":true,"link_text":"ADVANCED KNITTING","link_url":"","background":"","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}},"item_DKD6my":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/s-blob-v1-IMAGE-QQLRBj1HZF0.png","stretch_image":true,"link_text":"PERFORMANCE FINISH","link_url":"","background":"","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}}},"block_order":["item_aCY7hg","item_BCynqM","item_aaGpbL","item_NzHbHc","item_DKD6my"],"name":"Image link blocks","settings":{"full_width":false,"block_size_desktop":"medium","block_size_mobile":"medium","block_text_size":"base","subheading":"","title":"","content":"<h4>EXPERTS FROM YARN TO LOOP<\/h4>","link_url":"","link_text":"","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":""}},"timeline_48UwYt":{"type":"timeline","blocks":{"slide_R6e37k":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/all-lp-woolstories-mainbanner-cw0326-flc-m.jpg","navigation_label":"Fibre Selection","subheading":"","title":"Fibre Selection","content":"<p>The source 100% ultra-fine merino wool, selected for fineness, consistency, and quality. No blends. No compromise on raw material.<\/p>"}},"slide_yVnj9K":{"type":"slide","settings":{"navigation_label":"Spinning","subheading":"","title":"Spinning","content":"<p>The raw fibre is spun into yarn — a process that determines the final hand feel and knit structure. We work with yarn that's been spun to a consistent count for even tension across every piece.<\/p>"}},"slide_8E3PKH":{"type":"slide","settings":{"navigation_label":"Knitting","subheading":"","title":"Knitting","content":"<p>Each garment is knitted on fine-gauge machines that produce the clean, dense structure you feel in a Merso piece. The stitch density is calibrated for drape, warmth, and durability — not just surface appearance.<\/p><p><\/p>"}},"slide_q8VUFz":{"type":"slide","settings":{"navigation_label":"Fibre Treatment","subheading":"","title":"Fibre Treatment","content":"<p>The machine-washable treatment is applied during the finishing stage — a process that modifies the fibre's surface at a microscopic level to prevent shrinking and felting in the wash, without affecting breathability or softness.<\/p>"}},"slide_KbnpYU":{"type":"slide","settings":{"navigation_label":"Quality Control","subheading":"","title":"Quality Control","content":"<p>Every piece is inspected before it leaves the facility — dimensions, weight, stitch integrity, and surface finish. If it doesn't meet spec, it doesn't ship.<\/p>"}}},"block_order":["slide_R6e37k","slide_yVnj9K","slide_8E3PKH","slide_q8VUFz","slide_KbnpYU"],"disabled":true,"name":"Timeline","settings":{"full_width":true,"background":"","background_gradient":"","text_color":""}},"media_with_text_ybtYa6":{"type":"media-with-text","blocks":{"image_k4JtbF":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/s-blob-v1-IMAGE-q56PXr_-hQo.png","media_width":50,"media_position":"end","text_position":"place-self-center-start text-start","icon":"none","icon_width":48,"subheading":"Modern Craftsmanship","title":"","content":"<h4>KNITTING INNOVATION<\/h4><p>MERSO knitwear is developed around ultra-fine merino wool fibre, fit and construction. Soft against the skin. Breathable across seasons. Machine washable. Built for repeated wear. We call this <strong>Ultra Fine Feel<\/strong>.<\/p>","link_text":"","link_url":"","background":"#ffffff","background_gradient":"","text_color":"#333333","text_gradient":"","button_background":"","button_text_color":""}}},"block_order":["image_k4JtbF"],"name":"Media with text","settings":{"full_width":false,"alternate_media_position":false,"spacing":"none"}},"media_with_text_CGxyR9":{"type":"media-with-text","blocks":{"image_NgKwmG":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/s-blob-v1-IMAGE-D-cY1lSCXxY.png","media_width":50,"media_position":"start","text_position":"place-self-center-start text-start","icon":"none","icon_width":48,"subheading":"Ultra Fine Feel Wool","title":"","content":"<h4>SOFT FEEL, STRONG PERFORMANCE<\/h4><p>MERSO® uses 19.5 micron ultra-fine merino wool, selected for softness, resilience and natural performance. The result is lightweight knitwear with a soft handfeel and lasting shape retention.<\/p>","link_text":"","link_url":"","background":"#ffffff","background_gradient":"","text_color":"#333333","text_gradient":"","button_background":"","button_text_color":""}}},"block_order":["image_NgKwmG"],"name":"Media with text","settings":{"full_width":false,"alternate_media_position":false,"spacing":"none"}},"media_with_text_pM6YKi":{"type":"media-with-text","blocks":{"image_rE6CjY":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/s-blob-v1-IMAGE-3-vpwOUd3Ac.png","media_width":50,"media_position":"end","text_position":"place-self-center-start text-start","icon":"none","icon_width":48,"subheading":"Streamlined Knitting","title":"","content":"<h4>MORE LUXURY LESS MARKUP<\/h4><p>By streamlining operations, modernising sourcing and keeping more of the journey in our own hands, MERSO invests where it matters most: the product itself. The result is exceptional merino wool, without traditional luxury markups.<\/p>","link_text":"","link_url":"","background":"#ffffff","background_gradient":"","text_color":"#333333","text_gradient":"","button_background":"","button_text_color":""}}},"block_order":["image_rE6CjY"],"name":"Media with text","settings":{"full_width":false,"alternate_media_position":false,"spacing":"none"}},"text_with_icons_EQX3QD":{"type":"text-with-icons","blocks":{"item_w39fyG":{"type":"item","settings":{"icon":"picto-coupon","mobile_icon_width":24,"icon_width":32,"icon_background_type":"circle","icon_background":"","icon_color":"","title":"Thermoregulating","content":"<p>The natural crimp of the fibre traps warm air in the cold and releases excess heat when temperatures rise. <\/p>"}},"item_WRN3BJ":{"type":"item","settings":{"icon":"picto-coupon","mobile_icon_width":24,"icon_width":32,"icon_background_type":"circle","icon_background":"","icon_color":"","title":"Soft & Itch-Free","content":"<p>Ultra-fine merino fibres are thin enough to flex against the skin instead of poking into it. <\/p>"}},"item_M9qWcr":{"type":"item","settings":{"icon":"picto-coupon","mobile_icon_width":24,"icon_width":32,"icon_background_type":"circle","icon_background":"","icon_color":"","title":"Naturally Odour-Resistant","content":"<p>Merino has a natural antimicrobial structure that inhibits the bacteria responsible for odour. <\/p>"}}},"block_order":["item_w39fyG","item_WRN3BJ","item_M9qWcr"],"disabled":true,"name":"Text with icons","settings":{"full_width":true,"stack_on_mobile":false,"title":"","heading_tag":"h5","text_alignment":"center","icon_spacing":"medium","background":"","background_gradient":"","text_color":""}},"image_with_text_overlay_bxXbHT":{"type":"image-with-text-overlay","blocks":{"liquid_PWqBDy":{"type":"liquid","settings":{"liquid":"<div style=\"width: 100%; display: flex; justify-content: center; padding-top: 20px;\">\n  <img \n    src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0930\/0498\/8791\/files\/s-blob-v1-IMAGE-vdD7ySbwgy8.png?v=1779448982\" \n    alt=\"Brand visual\" \n    loading=\"lazy\" \n    style=\"display: block; max-width: 175px; width: 100%; height: auto; object-fit: contain; filter: brightness(0) invert(1); margin-bottom: 0;\"\n  >\n<\/div>"}},"richtext_MdMRxn":{"type":"richtext","disabled":true,"settings":{"content":"<h2>WOOLMARK CERTIFIED<\/h2>"}}},"block_order":["liquid_PWqBDy","richtext_MdMRxn"],"name":"Image with text overlay","settings":{"full_width":false,"allow_transparent_header":false,"enable_parallax":false,"image_size":"auto","image":"shopify:\/\/shop_images\/hf_20260517_205349_7ec11720-c67e-4a49-b305-ed6ded37d5e1.png","mobile_text_position":"place-self-center text-center","desktop_text_position":"sm:place-self-center sm:text-center","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}},"media_with_text_4CCiVz":{"type":"media-with-text","blocks":{"image_kL3LXj":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/s-blob-v1-IMAGE-uxoH82DT77Q.jpg","media_width":50,"media_position":"start","text_position":"place-self-center-start text-start","icon":"none","icon_width":48,"subheading":"Exceptional Standards","title":"","content":"<h4>GLOBALLY TRUSTED YARNS<\/h4><p>The Woolmark symbol is one of the world’s leading standards for wool quality, independently verified and globally trusted. A benchmark for exceptional wool quality and consistency.<\/p>","link_text":"","link_url":"","background":"#ffffff","background_gradient":"","text_color":"#000000","text_gradient":"","button_background":"","button_text_color":""}}},"block_order":["image_kL3LXj"],"name":"Media with text","settings":{"full_width":false,"alternate_media_position":false,"spacing":"none"}},"multi_column_DDhM3y":{"type":"multi-column","blocks":{"item_7Fw8Qt":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Component_5_9d6390df-594b-4c37-81ef-ffd65b997782.svg","show_controls":false,"column_size":"3","title":"100% Natural Wool  ","heading_tag":"h4","content":"<p>What's on the label is what's in the garment.<\/p>","link_url":"","link_text":"","link_style":"link"}},"item_393E9n":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Component_6.svg","show_controls":false,"column_size":"3","title":"Light colour fastness","heading_tag":"h4","content":"<p>Colour tested under  hours of intense light.<\/p>","link_url":"","link_text":"","link_style":"link"}},"item_mGMMgA":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Component_7.svg","show_controls":false,"column_size":"3","title":"Durability ","heading_tag":"h4","content":"<p>Pulled and stretched to its limits.<\/p>","link_url":"","link_text":"","link_style":"link"}},"item_C9aLM3":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Component_8.svg","show_controls":false,"column_size":"3","title":"Wash Testing","heading_tag":"h4","content":"<p>Machine washed. Shape must be retained.<\/p>","link_url":"","link_text":"","link_style":"link"}},"item_YAgJ3N":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Component_9.svg","show_controls":false,"column_size":"3","title":"Colour fastness to liquid","heading_tag":"h4","content":"<p>Tested against every liquid it  will ever meet.<\/p>","link_url":"","link_text":"","link_style":"link"}},"item_EbqXCR":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/Component_10.svg","show_controls":false,"column_size":"3","title":"Fibre Diameter","heading_tag":"h4","content":"<p>Independently measured. Finer than a human hair.<\/p>","link_url":"","link_text":"","link_style":"link"}}},"block_order":["item_7Fw8Qt","item_393E9n","item_mGMMgA","item_C9aLM3","item_YAgJ3N","item_EbqXCR"],"custom_css":[".multi-column__item {background: white; padding: 34px;}",".multi-column {gap: 8px;}"],"name":"Multi-column","settings":{"full_width":true,"stack_on_mobile":false,"gap":"medium","text_alignment":"start","subheading":"","title":"","content":"<h4>WOOLMARK CRITERIA<\/h4>","background":"#edebe8","background_gradient":"","text_color":""}},"multiple_images_with_text_zpg7kF":{"type":"multiple-images-with-text","blocks":{"item_jDk9GL":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/organic-100-logo-color.svg","image_rotation_degrees":-2,"subheading":"","title":"","content":"<h5>Organic Content Standard (OCS)<\/h5><p>The OCS aims to increase organic agricultural production.<\/p>","button_url":"","button_text":""}},"item_rRA8Dk":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/organic-100-logo-color.svg","image_rotation_degrees":-2,"subheading":"","title":"","content":"<h5>Organic Content Standard (OCS)<\/h5><p>The OCS aims to increase organic agricultural production.<\/p>","button_url":"","button_text":""}},"item_rAw9JR":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/organic-100-logo-color.svg","image_rotation_degrees":-2,"subheading":"","title":"","content":"<h5>Organic Content Standard (OCS)<\/h5><p>The OCS aims to increase organic agricultural production.<\/p>","button_url":"","button_text":""}}},"block_order":["item_jDk9GL","item_rRA8Dk","item_rAw9JR"],"disabled":true,"name":"Multiple images with text","settings":{"full_width":true,"images_layout":"stacked","collage_images_alignment":"top","background":"","background_gradient":"","text_color":"","button_background":"","button_text_color":""}},"multi_column_tyKG6w":{"type":"multi-column","bloc