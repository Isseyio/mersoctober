ery year. Just one sheeps, doing what it's always done.<\/p>","link_text":"","link_url":"","background":"#ffffff","background_gradient":"","text_color":"#000000","text_gradient":"","button_background":"","button_text_color":""}}},"block_order":["image_Yfdwz6"],"name":"Media with text","settings":{"full_width":false,"alternate_media_position":false,"spacing":"none"}},"multi_column_md3ixp":{"type":"multi-column","blocks":{"item_JcX88R":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/hf_20260517_205349_a753ace4-8bc2-4fa2-855a-88ced79f1989.png","show_controls":false,"column_size":"3","title":"Woolmark Certified","heading_tag":"h4","content":"","link_url":"shopify:\/\/pages\/why-merso","link_text":"Discover More","link_style":"link"}},"item_nbNGVE":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/hf_20260518_133928_7db6b329-4dcd-42a4-a2fb-b037d47ff78e.png","show_controls":false,"column_size":"3","title":"Synthetic Free","heading_tag":"h4","content":"","link_url":"shopify:\/\/pages\/why-merso-1","link_text":"Discover More","link_style":"link"}},"item_FdJVVA":{"type":"item","settings":{"image":"shopify:\/\/shop_images\/hf_20260517_215713_cae49137-d1ce-4225-a66e-00e094c0910a.png","show_controls":false,"column_size":"3","title":"Spun for Performance","heading_tag":"h4","content":"","link_url":"shopify:\/\/pages\/why-merso-1","link_text":"Discover More","link_style":"link"}}},"block_order":["item_JcX88R","item_nbNGVE","item_FdJVVA"],"name":"Multi-column","settings":{"full_width":true,"stack_on_mobile":false,"gap":"small","text_alignment":"start","subheading":"","title":"MASTERS IN MERINO","content":"","background":"#edebe8","background_gradient":"","text_color":""}}},"order":["main","image_with_text_overlay_DT9MEY","media_with_text_D6bJVT","media_with_text_kz34QK","media_with_text_9R8zc3","media_with_text_bgTehg","media_with_text_gaV86F","media_with_text_zJTgC6","media_with_text_RQRVwp","media_with_text_3MJjQ7","multi_column_md3ixp"]}