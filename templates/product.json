 space-between; margin-top: 16px; font-size: 12px; color: #555; }\n<\/style>"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_payment_button":false,"show_gift_card_recipient":false,"atc_button_background":"","atc_button_text_color":"","payment_button_background":"","payment_button_text_color":""}},"liquid_mBaH3i":{"type":"liquid","settings":{"liquid":"{% assign country_code = localization.country.iso_code %}\n{% case country_code %}\n  {% when 'NL' %}\n    {% assign delivery_days = '1' %}\n  {% when 'DE', 'BE', 'FR', 'IT', 'AT', 'DK', 'SE', 'PL', 'CZ', 'HU', 'LU', 'SI', 'HR', 'NO', 'CH', 'LI' %}\n    {% assign delivery_days = '3' %}\n  {% when 'ES', 'PT', 'FI', 'IE', 'RO', 'BG', 'SK', 'EE', 'LV', 'LT' %}\n    {% assign delivery_days = '4' %}\n  {% when 'GR', 'RS' %}\n    {% assign delivery_days = '7' %}\n  {% else %}\n    {% assign delivery_days = '5' %}\n{% endcase %}\n\n<style>\n  .trust-list {\n    list-style: none;\n    margin: 16px 0;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .trust-list li {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 12px;\n    color: inherit;\n  }\n  .trust-list svg {\n    flex-shrink: 0;\n    width: 18px;\n    height: 18px;\n    stroke: currentColor;\n    fill: none;\n    stroke-width: 1.5;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n<\/style>\n\n<ul class=\"trust-list\">\n  <li>\n    <!-- Delivery \/ box icon -->\n    <svg viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n      <path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"\/>\n      <polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"\/>\n      <line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"\/>\n    <\/svg>\n   <span>\n  {% if country_code == 'NL' %}\n    Next day delivery in NL\n  {% else %}\n    Delivery in {{ delivery_days }} business days to {{ localization.country.iso_code }}\n  {% endif %}\n<\/span>\n  <\/li>\n  <li>\n    <!-- Returns \/ refresh icon -->\n    <svg viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n      <polyline points=\"1 4 1 10 7 10\"\/>\n      <path d=\"M3.51 15a9 9 0 1 0 .49-4.95\"\/>\n    <\/svg>\n    <span>30-day hassle-free returns<\/span>\n  <\/li>\n  <li>\n    <!-- Secure payment \/ lock icon -->\n    <svg viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n      <rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"\/>\n      <path d=\"M7 11V7a5 5 0 0 1 10 0v4\"\/>\n    <\/svg>\n    <span>Secure and encrypted payments <\/span>\n  <\/li>\n<\/ul>"}},"separator_jWR4PC":{"type":"separator","settings":{}},"text_K8gjKf":{"type":"text","disabled":true,"settings":{"text":"{{ product.metafields.custom.details | metafield_tag }}"}},"liquid_Wr4AUW":{"type":"liquid","settings":{"liquid":"<style>\n  .trust-slider-wrapper {\n    overflow: hidden;\n    position: relative;\n    margin: 16px 0;\n  }\n  .trust-slider-track {\n    display: flex;\n    gap: 8px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n    cursor: grab;\n  }\n  .trust-slider-track::-webkit-scrollbar {\n    display: none;\n  }\n  .trust-slider-item {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    scroll-snap-align: start;\n    flex-shrink: 0;\n    font-size: 12px;\n    white-space: nowrap;\n    color: inherit;\n    background-color: #edebe8;\n    padding: 8px 14px;\n  }\n  .trust-slider-item svg {\n    flex-shrink: 0;\n    width: 22px;\n    height: 22px;\n    stroke: currentColor;\n    fill: none;\n    stroke-width: 1.5;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n<\/style>\n<div class=\"trust-slider-wrapper\">\n  <div class=\"trust-slider-track\" id=\"productTrustSlider\">\n    <div class=\"trust-slider-item\">\n      <svg viewBox=\"0 0 24 24\"><ellipse cx=\"12\" cy=\"12\" rx=\"6\" ry=\"9\"\/><path d=\"M9 7c1.5 2 1.5 8 0 10M12 5c1.5 2.5 1.5 11 0 14M15 7c1.5 2 1.5 8 0 10\"\/><\/svg>\n      <span>Odor resistant<\/span>\n    <\/div>\n    <div class=\"trust-slider-item\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M10 13.5V4a2 2 0 0 1 4 0v9.5a4 4 0 1 1-4 0z\"\/><circle cx=\"12\" cy=\"17\" r=\"1.5\" fill=\"currentColor\" stroke=\"none\"\/><path d=\"M18 5v6M18 5l-1.5 1.5M18 5l1.5 1.5M21 11V5M21 11l-1.5-1.5M21 11l1.5-1.5\"\/><\/svg>\n      <span>Temperature regulating<\/span>\n    <\/div>\n    <div class=\"trust-slider-item\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M3 16c2-1 3-1 4.5 0s2.5 1 4.5 0 3-1 4.5 0 2.5 1 4.5 0M3 19c2-1 3-1 4.5 0s2.5 1 4.5 0 3-1 4.5 0 2.5 1 4.5 0\"\/><path d=\"M7 11V5M7 5L5.5 6.5M7 5l1.5 1.5M12 11V4M12 4l-1.5 1.5M12 4l1.5 1.5M17 11V5M17 5l-1.5 1.5M17 5l1.5 1.5\"\/><\/svg>\n      <span>Anti-wrinkle<\/span>\n    <\/div>\n  <\/div>\n<\/div>\n<script>\n  (function() {\n    const slider = document.getElementById('productTrustSlider');\n    let isDown = false, startX, scrollLeft;\n    slider.addEventListener('mousedown', e => {\n      isDown = true;\n      slider.style.cursor = 'grabbing';\n      startX = e.pageX - slider.offsetLeft;\n      scrollLeft = slider.scrollLeft;\n    });\n    slider.addEventListener('mouseleave', () => { isDown = false; slider.style.cursor = 'grab'; });\n    slider.addEventListener('mouseup', () => { isDown = false; slider.style.cursor = 'grab'; });\n    slider.addEventListener('mousemove', e => {\n      if (!isDown) return;\n      e.preventDefault();\n      const x = e.pageX - slider.offsetLeft;\n      slider.scrollLeft = scrollLeft - (x - startX);\n    });\n  })();\n<\/script>"}},"collapsible_text_6cG3w8":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Product Details","content":"<ul><li>100% extra-fine Merino wool, 19.5 micron<\/li><li>Mid-weight knit, approx. 230 gsm<\/li><li>Ribbed crewneck collar, cuffs, and hem<\/li><li>Machine washable up to 40°C, gentle cycle, reshape and lay flat to dry<\/li><li>Thermoregulating: comfortable across a 10–30°C range<\/li><li>Odor-resistant, wears 3–5 times between washes<\/li><li>Woolmark certified for quality, traceability, and animal welfare<\/li><li>Breathable and moisture-wicking<\/li><\/ul>","page":""}},"collapsible_text_9mgVKf":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Sizing & Fit","content":"<ul><li>Runs tactically large<\/li><li>Comfortable fit<\/li><li>Lightweight, approx. 230 gsm knit<\/li><\/ul><p>Our models are 180 cm and wear size M. Our Fit Guide provides precise body measurements for each. The fit is designed to run slightly, tactically large to ensure comfort and shape retention over time. Refer to the chart on this page for full measurements.<\/p>","page":""}},"collapsible_text_9nh3bj":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Why Merino Wool","content":"<ul><li>19.5 micron: spun finer than standard Merino (typically 21–24 micron), well below the threshold where wool feels coarse against the skin<\/li><li>Softer than cotton, lighter than cashmere, an exceptionally fine, smooth handle<\/li><li>Temperature-regulating: comfortable across a 10–30°C range<\/li><li>Moisture-wicking: absorbs up to 35% of its weight in moisture before feeling damp<\/li><li>Naturally odor-resistant: wears 3–5 times between washes<\/li><li>Woolmark certified:  sourced from mills audited for quality, traceability, and animal welfare<\/li><\/ul>","page":""}},"collapsible_text_4UegFG":{"type":"collapsible_text","disabled":true,"settings":{"icon":"none","icon_width":20,"title":"Bundle & Save","content":"<p>The more you build, the more you save.<\/p><ul><li>1 piece — 16% off<\/li><li>2 pieces — 26% off<\/li><li>3 pieces — 36% off<\/li><\/ul><p>Mix and match across the collection. Discount applied automatically at checkout.<\/p>","page":""}},"collapsible_text_Ae889H":{"type":"collapsible_text","disabled":true,"settings":{"icon":"none","icon_width":20,"title":"Payment options & Security","content":"<p>Our Fit Guide provides precise body measurements for each style (Crew Neck, Zip Up, V-Neck and Long Sleeve Polo). The fit is designed to run slightly, tactically large to ensure comfort and shape retention over time. For more details, check the chart on each product page.<\/p>","page":""}},"collapsible_text_MAD4Jx":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Shipping & Returns","content":"<p><strong>Shipping<\/strong><\/p><ul><li>Flat fee of 5.95€ applied at checkout<\/li><li>Free shipping for orders containing 2+ knits.<\/li><\/ul><p>We ship via DHL Parcel. Estimated delivery times by country:<\/p><p><em>1 business day<\/em><\/p><ul><li>Netherlands (Mon–Sat)<\/li><\/ul><p><em>3 business days (Economy) \/ 2 business days (Worldwide)<\/em><\/p><ul><li>Germany, Belgium, France, Italy, Austria, Denmark, Sweden, Poland, Czech Republic, Hungary, Luxembourg, Slovenia, Croatia, Norway, Switzerland, Liechtenstein<\/li><\/ul><p><em>4 business days (Economy) \/ 2 business days (Worldwide)<\/em><\/p><ul><li>Spain, Finland, Ireland, Romania, Bulgaria, Slovakia, Estonia, Latvia, Lithuania<\/li><\/ul><p><em>4 business days (Economy) \/ 3 business days (Worldwide)<\/em><\/p><ul><li>Portugal<\/li><\/ul><p><em>7 business days (Economy) \/ 2 business days (Worldwide)<\/em><\/p><ul><li>Greece, Serbia<\/li><\/ul><p><strong>Returns<\/strong><\/p><ul><li>Free returns within 30 days of delivery<\/li><li>Items must be unworn, unwashed, and with all original tags attached<\/li><li>Refunds processed to your original payment method within 3–5 business days of receipt<\/li><\/ul>","page":""}},"associated_products_4BKBUV":{"type":"associated_products","settings":{"title":"Buy it with","stack_products":true,"products_count":3,"background":"","text_color":""}},"text_BQ7zG6":{"type":"text","settings":{"text":"<p>Need help? Contact our <a href=\"\/pages\/contact\" title=\"Contact\">client service<\/a><\/p>"}}},"block_