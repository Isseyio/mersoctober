{% doc %}
  @prompt
    Generate a hero banner, with text and an image, add every possible css styling for the image, and the text. Make sure it is both optimised for mobile and desktop
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.section_background_color }};
    border-radius: 30px;
  }

  .ai-hero-banner__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.layout_mobile }};
    align-items: {{ block.settings.vertical_alignment }};
    justify-content: {{ block.settings.horizontal_alignment }};
    gap: {{ block.settings.content_gap_mobile }}px;
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    min-height: {{ block.settings.min_height_mobile }}px;
  }

  .ai-hero-banner__content-{{ ai_gen_id }} {
    flex: 1;
    z-index: 2;
    max-width: {{ block.settings.text_max_width }}px;
    text-align: {{ block.settings.text_alignment_mobile }};
  }

  .ai-hero-banner__heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    font-size: {{ block.settings.heading_size_mobile }}px;
    font-weight: {{ block.settings.heading_font_weight }};
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    color: {{ block.settings.heading_color }};
    text-transform: {{ block.settings.heading_text_transform }};
    word-break: break-word;
  }

  .ai-hero-banner__subheading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.subheading_margin_bottom }}px;
    font-size: {{ block.settings.subheading_size_mobile }}px;
    font-weight: {{ block.settings.subheading_font_weight }};
    line-height: {{ block.settings.subheading_line_height }};
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    color: {{ block.settings.subheading_color }};
    text-transform: {{ block.settings.subheading_text_transform }};
  }

  .ai-hero-banner__text-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.text_margin_bottom }}px;
    font-size: {{ block.settings.text_size_mobile }}px;
    font-weight: {{ block.settings.text_font_weight }};
    line-height: {{ block.settings.text_line_height }};
    letter-spacing: {{ block.settings.text_letter_spacing }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-hero-banner__button-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.button_layout_mobile }};
    gap: {{ block.settings.button_gap }}px;
    justify-content: {{ block.settings.button_alignment_mobile }};
    flex-wrap: wrap;
  }

  .ai-hero-banner__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-decoration: none;
    text-transform: {{ block.settings.button_text_transform }};
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.primary_button_border_color }};
    background-color: {{ block.settings.primary_button_background }};
    color: {{ block.settings.primary_button_text_color }};
    cursor: pointer;
    white-space: nowrap;
  }

  .ai-hero-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_background }};
    color: {{ block.settings.primary_button_hover_text_color }};
    border-color: {{ block.settings.primary_button_hover_border_color }};
    transform: translateY({{ block.settings.button_hover_transform }}px);
  }

  .ai-hero-banner__button--secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.secondary_button_background }};
    color: {{ block.settings.secondary_button_text_color }};
    border-color: {{ block.settings.secondary_button_border_color }};
  }

  .ai-hero-banner__button--secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_background }};
    color: {{ block.settings.secondary_button_hover_text_color }};
    border-color: {{ block.settings.secondary_button_hover_border_color }};
  }

  .ai-hero-banner__image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: {{ block.settings.image_shadow_horizontal }}px {{ block.settings.image_shadow_vertical }}px {{ block.settings.image_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.image_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-hero-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    object-position: {{ block.settings.image_position }};
    filter: brightness({{ block.settings.image_brightness }}%) contrast({{ block.settings.image_contrast }}%) saturate({{ block.settings.image_saturation }}%) blur({{ block.settings.image_blur }}px) grayscale({{ block.settings.image_grayscale }}%);
    opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
    transform: scale({{ block.settings.image_scale | divided_by: 100.0 }}) rotate({{ block.settings.image_rotate }}deg);
    transition: transform 0.3s ease, filter 0.3s ease;
  }


  .ai-hero-banner__image-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ block.settings.image_overlay_color }};
    opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }

  .ai-hero-banner__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 300px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-banner__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-hero-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-banner__container-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.layout_desktop }};
      gap: {{ block.settings.content_gap_desktop }}px;
      padding: {{ block.settings.padding_top_desktop }}px {{ block.settings.padding_horizontal_desktop }}px {{ block.settings.padding_bottom_desktop }}px;
      min-height: {{ block.settings.min_height_desktop }}px;
    }

    .ai-hero-banner__content-{{ ai_gen_id }} {
      text-align: {{ block.settings.text_alignment_desktop }};
    }

    .ai-hero-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-hero-banner__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
    }

    .ai-hero-banner__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_desktop }}px;
    }

    .ai-hero-banner__button-wrapper-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.button_layout_desktop }};
      justify-content: {{ block.settings.button_alignment_desktop }};
    }
  }
{% endstyle %}

<div class="ai-hero-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-banner__container-{{ ai_gen_id }}">
    <div class="ai-hero-banner__content-{{ ai_gen_id }}">
      {% if block.settings.subheading != blank %}
        <div class="ai-hero-banner__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-hero-banner__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-hero-banner__text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank or block.settings.button_text_secondary != blank %}
        <div class="ai-hero-banner__button-wrapper-{{ ai_gen_id }}">
          {% if block.settings.button_text != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="ai-hero-banner__button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_text }}
            </a>
          {% endif %}

          {% if block.settings.button_text_secondary != blank %}
            <a
              href="{{ block.settings.button_link_secondary }}"
              class="ai-hero-banner__button-{{ ai_gen_id }} ai-hero-banner__button--secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_text_secondary }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="ai-hero-banner__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-hero-banner__image-{{ ai_gen_id }}"
        >
        <div class="ai-hero-banner__image-overlay-{{ ai_gen_id }}"></div>
      {% else %}
        <div class="ai-hero-banner__image-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-hero-banner__empty-state-{{ ai_gen_id }}">
            Add an image to complete your hero banner
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

