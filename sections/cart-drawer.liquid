{%- comment -%}
  When the drawer asks Shopify for product recommendations, this same section is rendered through the
  /recommendations/products endpoint: only the upsell cards are returned in that case.
{%- endcomment -%}
{%- if recommendations.performed -%}
  <div data-cd-recs-result>
    {%- assign cd_rendered = 0 -%}
    {%- for recommended_product in recommendations.products -%}
      {%- assign in_cart = cart | line_items_for: recommended_product -%}
      {%- if in_cart.size > 0 or recommended_product.available == false -%}{%- continue -%}{%- endif -%}
      {%- render 'cart-drawer-upsell-card', product: recommended_product, section: section -%}
      {%- assign cd_rendered = cd_rendered | plus: 1 -%}
      {%- if cd_rendered >= section.settings.upsell_limit -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  </div>
{%- else -%}

{{- 'cart-drawer-custom.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'cart-drawer-custom.js' | asset_url }}" defer></script>

<style>
  #cart-drawer {
    --cd-announcement-bg: {{ section.settings.announcement_background }};
    --cd-announcement-text: {{ section.settings.announcement_text_color }};
    --cd-progress-fill: {{ section.settings.progress_fill_color }};
    --cd-checkout-bg: {{ section.settings.checkout_background }};
    --cd-checkout-text: {{ section.settings.checkout_text_color }};
    {%- case section.settings.upsell_image_focus -%}
      {%- when 'top' -%}{%- assign cd_focus = '50% 0%' -%}
      {%- when 'center' -%}{%- assign cd_focus = '50% 50%' -%}
      {%- when 'bottom' -%}{%- assign cd_focus = '50% 100%' -%}
      {%- else -%}{%- assign cd_focus = '50% 70%' -%}
    {%- endcase %}
    --cd-upsell-focus: {{ cd_focus }};
    {%- if section.settings.product_card_background != blank and section.settings.product_card_background != 'rgba(0,0,0,0)' %}
    --cd-card-bg: {{ section.settings.product_card_background }};
    {%- endif %}
    {%- if section.settings.product_card_text_color != blank and section.settings.product_card_text_color != 'rgba(0,0,0,0)' %}
    --cd-card-text: {{ section.settings.product_card_text_color }};
    {%- endif %}
  }
</style>

<cart-drawer {% if request.design_mode %}handle-section-events{% endif %} class="cart-drawer drawer drawer--lg" id="cart-drawer">
  {%- if cart.item_count == 0 -%}
    <button is="close-button" aria-label="{{ 'general.accessibility.close' | t | escape }}">
      {%- render 'icon' with 'close' -%}
    </button>

    <div class="empty-state align-self-center">
      <div class="empty-state__icon-wrapper">
        {%- render 'icon' with 'cart', width: 32, height: 32, stroke_width: 1 -%}
        <span class="count-bubble count-bubble--lg">0</span>
      </div>

      <div class="prose">
        <p class="h5">{{ 'cart.general.empty' | t }}</p>

        {%- assign button_content = 'cart.general.continue_shopping' | t -%}
        {%- render 'button', href: settings.cart_empty_button_link, size: 'xl', content: button_content -%}
      </div>
    </div>
  {%- else -%}
    {%- liquid
      # ------------------------------------------------------------------------------------------------------------
      # Bundle progress: count the qualifying items (knits) in the cart
      # ------------------------------------------------------------------------------------------------------------
      assign cd_threshold = section.settings.bundle_threshold
      assign cd_match_terms = section.settings.bundle_match | downcase | split: ','
      assign cd_bundle_count = 0
      assign cd_knit_sale_savings = 0
      assign cd_knit_value = 0

      for item in cart.items
        assign qualifies = true

        if section.settings.bundle_match != blank
          assign qualifies = false
          assign item_type = item.product.type | downcase

          for term in cd_match_terms
            assign term_clean = term | strip
            if term_clean == blank
              continue
            endif

            if item_type contains term_clean
              assign qualifies = true
            endif

            for tag in item.product.tags
              assign tag_clean = tag | downcase | strip
              if tag_clean == term_clean
                assign qualifies = true
              endif
            endfor
          endfor
        endif

        if qualifies
          assign cd_bundle_count = cd_bundle_count | plus: item.quantity
          assign cd_knit_value = cd_knit_value | plus: item.original_line_price
          if item.variant.compare_at_price > item.original_price
            assign q_saving = item.variant.compare_at_price | minus: item.original_price | times: item.quantity
            assign cd_knit_sale_savings = cd_knit_sale_savings | plus: q_saving
          endif
        endif
      endfor

      assign cd_bundle_reached = false
      if cd_bundle_count >= cd_threshold
        assign cd_bundle_reached = true
      endif

      assign cd_remaining = cd_threshold | minus: cd_bundle_count | at_least: 0

      if cd_remaining == 1
        assign cd_remaining_unit = section.settings.bundle_unit_singular
      else
        assign cd_remaining_unit = section.settings.bundle_unit_plural
      endif

      assign cd_count_label = cd_bundle_count | append: ' / ' | append: cd_threshold | append: ' ' | append: section.settings.bundle_unit_plural


      # ------------------------------------------------------------------------------------------------------------
      # Free shipping status: unlocked by the bundle, by a cart amount, or by a free shipping discount code
      # ------------------------------------------------------------------------------------------------------------
      assign cd_ship_mode = section.settings.free_shipping_trigger
      assign cd_ship_unlocked = false
      assign cd_ship_unreached = ''

      for discount_application in cart.discount_applications
        if discount_application.target_type == 'shipping_line' and discount_application.value_type == 'percentage' and discount_application.value >= 100
          assign cd_ship_unlocked = true
        endif
      endfor

      case cd_ship_mode
        when 'bundle'
          if cd_bundle_reached
            assign cd_ship_unlocked = true
          endif
          assign cd_ship_unreached = 'cart.drawer.free_shipping_remaining_items' | t: remaining: cd_remaining, units: cd_remaining_unit

        when 'amount'
          assign cd_ship_threshold = settings.cart_free_shipping_threshold | times: 100 | round
          assign cd_ship_left = cd_ship_threshold | minus: cart.total_price

          if cd_ship_left <= 0
            assign cd_ship_unlocked = true
          endif

          # Say it in knits ("You're one knit away from free shipping"): the gap divided by the average knit price.
          # The bundle deal lowers the total once the bundle completes, so it is added to the gap until then.
          assign cd_avg_knit_price = 0
          if cd_bundle_count > 0
            assign cd_avg_knit_price = cd_knit_value | divided_by: cd_bundle_count
          elsif cart.item_count > 0
            assign cd_avg_knit_price = cart.items_subtotal_price | divided_by: cart.item_count
          endif

          if cd_avg_knit_price > 0
            assign cd_ship_gap = cd_ship_left
            unless cd_bundle_reached
              assign cd_ship_deal = section.settings.bundle_discount_amount | remove: '€' | replace: ',', '.' | strip | times: 100 | round
              assign cd_ship_gap = cd_ship_gap | plus: cd_ship_deal
            endunless
            assign cd_ship_knits = cd_ship_gap | times: 1.0 | divided_by: cd_avg_knit_price | ceil | at_least: 1
            assign cd_ship_unreached = 'cart.drawer.free_shipping_remaining_knits' | t: count: cd_ship_knits
          else
            assign cd_ship_left_money = cd_ship_left | at_least: 0 | money
            assign cd_ship_unreached = 'cart.drawer.free_shipping_remaining_amount' | t: amount: cd_ship_left_money
          endif
      endcase

      # Shipping cost shown in the footer (and added to the total) while free shipping is not unlocked
      assign cd_ship_cost = 0
      if section.settings.shipping_cost != blank
        assign cd_ship_cost = section.settings.shipping_cost | remove: '€' | replace: ',', '.' | strip | times: 100 | round
      endif

      assign cd_ship_charge = 0
      if cart.requires_shipping and cd_ship_unlocked == false
        assign cd_ship_charge = cd_ship_cost
      endif

      assign cd_show_ship_status = false
      if cart.requires_shipping
        if cd_ship_mode != 'none' or cd_ship_unlocked
          assign cd_show_ship_status = true
        endif
      endif

      # ------------------------------------------------------------------------------------------------------------
      # Footer totals: original value (compare-at prices) and total saved (compare-at + all Shopify discounts)
      # ------------------------------------------------------------------------------------------------------------
      assign cd_original_total = 0

      for item in cart.items
        assign unit_original = item.original_price
        if item.variant.compare_at_price > item.original_price
          assign unit_original = item.variant.compare_at_price
        endif
        assign line_original = unit_original | times: item.quantity
        assign cd_original_total = cd_original_total | plus: line_original
      endfor

      assign cd_total_savings = 0
      if cd_original_total > cart.total_price
        assign cd_total_savings = cd_original_total | minus: cart.total_price
      endif

      assign cd_discount_codes = cart.discount_applications | where: 'type', 'discount_code'

      # ------------------------------------------------------------------------------------------------------------
      # Bundle message in euros: what the customer saves in total once the bundle is complete
      #   = current savings (compare-at + discounts) + sale saving of each missing knit + the bundle deal
      # ------------------------------------------------------------------------------------------------------------
      if cd_bundle_reached
        assign cd_bundle_saving_money = cd_total_savings | money | prepend: '<strong>' | append: '</strong>'
        assign cd_message = section.settings.bundle_reached_message | escape | replace: '[amount]', cd_bundle_saving_money
      else
        assign cd_bundle_deal = section.settings.bundle_discount_amount | remove: '€' | replace: ',', '.' | strip | times: 100 | round
        assign cd_avg_knit_saving = 0
        if cd_bundle_count > 0
          assign cd_avg_knit_saving = cd_knit_sale_savings | divided_by: cd_bundle_count
        endif
        assign cd_projected_saving = cd_avg_knit_saving | times: cd_remaining | plus: cd_total_savings | plus: cd_bundle_deal
        assign cd_projected_money = cd_projected_saving | money | prepend: '<strong>' | append: '</strong>'
        assign cd_message = section.settings.bundle_unreached_message | escape | replace: '[remaining]', cd_remaining | replace: '[units]', cd_remaining_unit | replace: '[amount]', cd_projected_money
      endif
    -%}

    <div class="cart-drawer__inner cd-inner">
      {%- if section.settings.announcement_text != blank -%}
        <div class="cd-announcement">
          <p>{{ section.settings.announcement_text | escape }}</p>
        </div>
      {%- endif -%}

      <div class="cart-drawer__top cd-top">
        <div class="cd-header">
          <p class="cd-header__title" id="cart-drawer-title">
            {{- section.settings.drawer_title | escape }} (<cart-count>{{ cart.item_count }}</cart-count>)
          </p>

          <button type="button" is="close-button" class="drawer__close-icon cd-header__close">
            <span class="sr-only">{{ 'general.accessibility.close' | t }}</span>
            {%- render 'icon' with 'close' -%}
          </button>
        </div>

      </div>

      {%- if section.settings.show_cart_timer -%}
        <div id="cart-timer-bar" style="display: flex; align-items: center; justify-content: center; gap: 8px; background: #f5f0eb; margin-bottom: 20px; padding: 8px 12px; font-size: 13px;">
          <span>Your cart is reserved for <strong id="cart-countdown">10:00</strong></span>
        </div>
      {%- endif -%}

      <div class="cd-body">
        <div class="cart-drawer__line-items cd-lines">
          {%- for line_item in cart.items -%}
            {%- render 'cart-drawer-line-item', line_item: line_item, index: forloop.index, section: section -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.show_bundle_progress -%}
          <div class="cd-progress {% if cd_bundle_reached %}is-reached{% endif %}" style="--cd-steps: {{ cd_threshold }}">
            <div class="cd-progress__row">
              <p class="cd-progress__message" aria-live="polite">
                {%- if cd_bundle_reached -%}
                  <svg class="cd-progress__check" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="8" fill="currentColor"/><path d="M4.5 8.3l2.2 2.2 4.8-5" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- endif -%}
                <span>{{ cd_message }}</span>
              </p>
              <p class="cd-progress__count">{{ cd_count_label }}</p>
            </div>

            <div
              class="cd-progress__bar"
              role="progressbar"
              aria-label="{{ section.settings.bundle_unit_plural | escape }}"
              aria-valuemin="0"
              aria-valuemax="{{ cd_threshold }}"
              aria-valuenow="{{ cd_bundle_count | at_most: cd_threshold }}"
              aria-valuetext="{{ cd_count_label | escape }}"
            >
              {%- for step in (1..cd_threshold) -%}
                <span class="cd-progress__step {% if step <= cd_bundle_count %}is-filled{% endif %}"></span>
              {%- endfor -%}
            </div>

            {%- if cd_show_ship_status -%}
              <p class="cd-shipping {% if cd_ship_unlocked %}is-unlocked{% endif %}" aria-live="polite">
                <svg class="cd-shipping__icon" aria-hidden="true" focusable="false" width="18" height="14" viewBox="0 0 18 14"><path d="M1 1.5h10v8.5H1zM11 4.5h3.5L17 7.5v2.5h-6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="4.5" cy="11.5" r="1.5" fill="#fff" stroke="currentColor" stroke-width="1.2"/><circle cx="13.5" cy="11.5" r="1.5" fill="#fff" stroke="currentColor" stroke-width="1.2"/></svg>
                <span>
                  {%- if cd_ship_unlocked -%}
                    {{- 'cart.drawer.free_shipping_activated' | t -}}
                  {%- else -%}
                    {{- cd_ship_unreached -}}
                  {%- endif -%}
                </span>
                {%- if cd_ship_unlocked -%}
                  <svg class="cd-shipping__check" aria-hidden="true" focusable="false" width="10" height="10" viewBox="0 0 12 12"><path d="M1.5 6.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>
        {%- elsif settings.cart_show_free_shipping_threshold -%}
          {%- render 'free-shipping-bar' -%}
        {%- endif -%}

        {%- liquid
          # ------------------------------------------------------------------------------------------------------------
          # "Finish bundle deal" upsell
          # ------------------------------------------------------------------------------------------------------------
          assign cd_upsell_source = section.settings.upsell_source
          assign cd_upsell_rendered = 0
          assign cd_carousel_id = section.id | append: '-cd-upsell'

          case cd_upsell_source
            when 'collection'
              assign cd_upsell_products = section.settings.upsell_collection.products
            when 'manual'
              assign cd_upsell_products = section.settings.products
            else
              assign cd_upsell_products = nil
          endcase

          capture cd_upsell_cards
            if cd_upsell_source == 'related' or cd_upsell_source == 'complementary'
              assign cd_in_cart_ids = cart.items | map: 'product_id' | uniq | join: ','
              echo '<cart-drawer-recommendations class="cd-upsell__recs" section-id="' | append: section.id | append: '" product-id="' | append: cart.items.first.product_id | append: '" limit="' | append: section.settings.upsell_limit | append: '" intent="' | append: cd_upsell_source | append: '" exclude="' | append: cd_in_cart_ids | append: '"></cart-drawer-recommendations>'
              assign cd_upsell_rendered = 1
            else
              for upsell_product in cd_upsell_products
                assign in_cart = cart | line_items_for: upsell_product
                if in_cart.size > 0 or upsell_product.available == false
                  continue
                endif

                render 'cart-drawer-upsell-card', product: upsell_product, section: section
                assign cd_upsell_rendered = cd_upsell_rendered | plus: 1

                if cd_upsell_rendered >= section.settings.upsell_limit
                  break
                endif
              endfor

              # Fallback: nothing selected (or everything selected is already in the cart), so use the collections
              # of the products in the cart
              if cd_upsell_rendered == 0
                assign cd_seen_ids = ','

                for cart_item in cart.items
                  for cart_collection in cart_item.product.collections limit: 5
                    if cart_collection.handle == 'all' or cart_collection.handle == 'frontpage'
                      continue
                    endif

                    for upsell_product in cart_collection.products limit: 50
                      assign upsell_id_key = ',' | append: upsell_product.id | append: ','
                      if cd_seen_ids contains upsell_id_key
                        continue
                      endif
                      assign cd_seen_ids = cd_seen_ids | append: upsell_product.id | append: ','

                      assign in_cart = cart | line_items_for: upsell_product
                      if in_cart.size > 0 or upsell_product.available == false
                        continue
                      endif

                      render 'cart-drawer-upsell-card', product: upsell_product, section: section
                      assign cd_upsell_rendered = cd_upsell_rendered | plus: 1

                      if cd_upsell_rendered >= section.settings.upsell_limit
                        break
                      endif
                    endfor

                    if cd_upsell_rendered >= section.settings.upsell_limit
                      break
                    endif
                  endfor

                  if cd_upsell_rendered >= section.settings.upsell_limit
                    break
                  endif
                endfor
              endif
            endif
          endcapture
        -%}

        {%- if cd_upsell_rendered > 0 -%}
          <div class="cd-upsell {% unless cd_bundle_reached %}cd-upsell--no-heading{% endunless %}" role="region" aria-labelledby="{{ cd_carousel_id }}-title">
            <div class="cd-upsell__header">
              <p class="cd-upsell__heading {% unless cd_bundle_reached %}sr-only{% endunless %}" id="{{ cd_carousel_id }}-title">{{ section.settings.recommendations_title | escape }}</p>

              <div class="cd-upsell__nav">
                <button type="button" class="cd-upsell__arrow" data-cd-carousel-prev aria-controls="{{ cd_carousel_id }}" aria-label="{{ 'general.accessibility.previous' | t | escape }}" disabled>
                  <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14"><path d="M9 2L4 7l5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                </button>
                <button type="button" class="cd-upsell__arrow" data-cd-carousel-next aria-controls="{{ cd_carousel_id }}" aria-label="{{ 'general.accessibility.next' | t | escape }}">
                  <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14"><path d="M5 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                </button>
              </div>
            </div>

            <cart-drawer-carousel id="{{ cd_carousel_id }}" class="cd-upsell__track">
              {{- cd_upsell_cards -}}
            </cart-drawer-carousel>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="v-stack gap-4 sm:gap-5 cd-footer" slot="footer">
      {%- liquid
        # Applied discount codes are shown as chips with their % or amount (e.g. "Code WELCOME10 · 10% off (−€8,50)")
        assign cd_show_code_chips = false
        if cd_discount_codes.size > 0
          assign cd_show_code_chips = true
        endif
      -%}

      {%- if section.settings.allow_discount_application or cd_show_code_chips -%}
        <div class="v-stack gap-2.5">
          {%- if section.settings.allow_discount_application -%}
            {%- render 'cart-discount' -%}
          {%- endif -%}

          {%- if cd_show_code_chips -%}
            <div class="h-stack gap-2 wrap">
              {%- for discount_application in cd_discount_codes -%}
                <div class="badge cd-code-chip">
                  {%- render 'icon' with 'discount' -%}
                  {%- render 'cart-drawer-discount-label', discount_application: discount_application, section: section %}
                  {%- if discount_application.target_type != 'shipping_line' and discount_application.total_allocated_amount > 0 %} (−{{ discount_application.total_allocated_amount | money }}){%- endif -%}

                  {%- if section.settings.allow_discount_application -%}
                    <cart-discount-remove-button discount-code="{{ discount_application.title | escape }}" class="h-stack align-center">
                      <button type="button" aria-label="{{ 'cart.order.remove' | t | escape }}: {{ discount_application.title | escape }}">{%- render 'icon' with 'delete', width: 8, stroke_width: 3 -%}</button>
                    </cart-discount-remove-button>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="v-stack gap-1">
        <div class="cd-totals">
          <div class="cd-totals__row">
            <p>{{ 'cart.general.subtotal' | t }}</p>
            <p>{{ cd_original_total | money }}</p>
          </div>

          {%- if cart.requires_shipping -%}
            <div class="cd-totals__row">
              <p>{{ 'cart.drawer.shipping' | t }}</p>
              {%- if cd_ship_unlocked -%}
                <p class="cd-totals__free">{{ 'cart.drawer.shipping_free' | t }}</p>
              {%- elsif cd_ship_cost > 0 -%}
                <p>{{ cd_ship_cost | money }}</p>
              {%- else -%}
                <p>{{ 'cart.drawer.shipping_calculated' | t }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="cd-totals__row cd-totals__row--total">
            <p>{{ 'cart.general.total' | t }}</p>

            <p class="cd-totals__final">
              {%- if cd_total_savings > 0 -%}
                {%- assign cd_total_savings_money = cd_total_savings | money -%}
                <span class="cd-saved-pill">{{ 'cart.drawer.you_saved' | t: amount: cd_total_savings_money }}</span>
              {%- endif -%}
              <span>{{ cart.total_price | plus: cd_ship_charge | money }}</span>
            </p>
          </div>
        </div>

        {%- if section.settings.show_cart_note -%}
          <button type="button" class="justify-self-start" aria-controls="cart-drawer-note">
            <span class="link text-sm text-subdued">
              {%- if cart.note == blank -%}
                {{- 'cart.general.add_order_note' | t -}}
              {%- else -%}
                {{- 'cart.general.edit_order_note' | t -}}
              {%- endif -%}
            </span>
          </button>

          <cart-note-dialog id="cart-drawer-note" class="cart-drawer__note">
            <div class="cart-drawer__note-inner">
              <div class="v-stack gap-4 sm:gap-6">
                <p class="h5">{{ 'cart.general.order_note' | t }}</p>

                <cart-note class="v-stack gap-4">
                  {%- assign order_note = 'cart.general.order_note' | t -%}
                  {%- assign order_save_label = 'cart.general.save_note' | t -%}

                  {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note -%}

                  <div class="justify-self-start">
                    {%- render 'button', type: 'button', content: order_save_label, size: 'lg', is: 'close-button', secondary: true -%}
                  </div>
                </cart-note>
              </div>
            </div>
          </cart-note-dialog>
        {%- endif -%}
      </div>

      <form action="{{ routes.cart_url }}" method="POST" class="buy-buttons cd-buy-buttons {% if section.settings.show_checkout_button %}buy-buttons--compact{% endif %}">
        {%- if section.settings.show_view_cart_button or section.settings.show_checkout_button == false -%}
          <a href="{{ routes.cart_url }}" class="button button--xl {% if section.settings.show_checkout_button %}button--secondary{% endif %}" data-no-instant>
            {{- 'cart.general.view_cart' | t -}}
          </a>
        {%- endif -%}

        {%- if section.settings.show_checkout_button -%}
          <button type="submit" name="checkout" class="cd-checkout">
            <span>{{ section.settings.checkout_text | escape }}</span>
            <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14"><path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
        {%- endif -%}
      </form>

      <img
          src="https://cdn.shopify.com/s/files/1/0930/0498/8791/files/Trustpilot_300_x_50_px_4.svg?v=1781008709"
          alt="Trustpilot"
          style="display: block; margin: 0 auto; width: 200px;"
        />
    </div>
  {%- endif -%}
</cart-drawer>
<script>
  // IP country detection
  fetch("https://ipwho.is/")
    .then(res => res.json())
    .then(data => {
      const code = data.country_code;
      const flag = code.replace(/./g, char =>
        String.fromCodePoint(127397 + char.charCodeAt())
      );
      document.getElementById("customer-country").innerText = `${flag} ${code}`;
    })
    .catch(() => {
      document.getElementById("customer-country").innerText = "Your Country";
    });

  // Cart timer
  (function() {
    const TIMER_KEY = 'cart_timer_end';
    const DURATION = 10 * 60; // 10 minutes in seconds

    function getEndTime() {
      const stored = sessionStorage.getItem(TIMER_KEY);
      if (stored) return parseInt(stored);
      const end = Math.floor(Date.now() / 1000) + DURATION;
      sessionStorage.setItem(TIMER_KEY, end);
      return end;
    }

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60).toString().padStart(2, '0');
      const s = (seconds % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    function tick() {
      const end = getEndTime();
      const remaining = end - Math.floor(Date.now() / 1000);
      const el = document.getElementById('cart-countdown');
      const bar = document.getElementById('cart-timer-bar');

      if (!el) return;

      if (remaining <= 0) {
        el.innerText = '00:00';
        if (bar) bar.style.background = '#fde8e8';
        sessionStorage.removeItem(TIMER_KEY);
        return;
      }

      el.innerText = formatTime(remaining);

      // Turn red in last 2 minutes
      if (bar) {
        bar.style.background = remaining <= 120 ? '#fde8e8' : '#f5f0eb';
      }
    }

    tick();
    setInterval(tick, 1000);
  })();
</script>
{%- endif -%}

